# Personal Brain - Environment Configuration

# --- Brain: Google OAuth (untuk Gmail + Google Calendar) ---
# Dapatkan dari Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/auth/google/callback

# --- Brain: Twitter/X API v2 ---
# Dapatkan dari developer.twitter.com > App > Keys and Tokens
TWITTER_BEARER_TOKEN=

# --- Brain: Folder catatan markdown ---
BRAIN_NOTES_FOLDER=D:/Project GitHub Brain Memory/Notes