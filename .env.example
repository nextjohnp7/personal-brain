# Personal Brain - Environment Configuration

# --- Brain: Google OAuth (for Gmail + Google Calendar) ---
# Get from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/auth/google/callback

# --- Brain: Twitter/X API v2 ---
# Get from developer.twitter.com > App > Keys and Tokens
TWITTER_BEARER_TOKEN=

# --- Brain: Encryption ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BRAIN_DB_KEY=

# --- Brain: Authentication ---
# Web dashboard login (set both to enable password protection)
BRAIN_DASHBOARD_USER=
BRAIN_DASHBOARD_PASSWORD=
# Flask session secret (generate: python -c "import secrets; print(secrets.token_hex(32))")
BRAIN_DASHBOARD_SECRET=

# MCP server API key (required for remote access)
BRAIN_MCP_API_KEY=

# Web API key (protects /export and /import endpoints)
BRAIN_API_KEY=

# --- Brain: Markdown notes folder ---
BRAIN_NOTES_FOLDER=./Notes

# --- Brain: Sync Daemon ---
# Sync interval in seconds (default: 300 = 5 minutes)
BRAIN_DAEMON_INTERVAL=300
# Google OAuth token file (for Gmail + Calendar sync)
GOOGLE_TOKEN_FILE=google_token.json

# --- Brain: Tailscale (Remote MCP access) ---
# Install Tailscale: https://tailscale.com/download
# After login, run: tailscale up
# MCP server will be accessible at <tailscale-ip>:8765
TAILSCALE_ENABLED=false